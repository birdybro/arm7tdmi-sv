{
  "schema": "arm7tdmis-table7-cross-map-v1",
  "coverage_model": "Exact directed legal-equivalence crosses. Values marked not-applicable are excluded instead of manufacturing illegal Cartesian combinations; every counted row is owned by a hashed testbench and a hashed full-regression PASS log.",
  "required_crosses": [
    "class_waveform_endian_stall",
    "class_condition_mode",
    "register_pc_state",
    "multiply_class_m",
    "block_class_n",
    "coprocessor_class_b_n",
    "memory_class_endian_alignment",
    "memory_class_abort",
    "class_interrupt_exception"
  ],
  "crosses": {
    "class_waveform_endian_stall": {
      "description": "All 17 base Chapter 7 family paths execute under both byte orders, continuously and with deterministic 1-to-4-cycle CLKEN holds at every Execute phase.",
      "dimensions": {
        "instruction_class": [
          "dp",
          "dp-register-shift",
          "mul",
          "mla",
          "mull",
          "ldr",
          "str",
          "ldrh",
          "strh",
          "ldm",
          "stm",
          "swp",
          "branch",
          "swi",
          "undefined",
          "condition-fail",
          "psr-transfer"
        ],
        "endian": [
          "little",
          "big"
        ],
        "stall_profile": [
          "continuous",
          "hold-every-execute-phase-1-to-4-cycles"
        ]
      },
      "minimum_rows": 68,
      "evidence": [
        {
          "phase": "integration-table7_core_phase_matrix",
          "source": "tb/integration/arm7tdmis_table7_core_phase_matrix_tb.sv",
          "marker": "\\[table7_core_phase_matrix\\] PASS \\(2 endian x 2 stall profiles x 17 rows = 68 reset-isolated cases\\)",
          "expected_rows": 68
        }
      ]
    },
