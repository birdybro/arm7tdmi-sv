debug_cover: read_slang --std 1800-2017 --allow-use-before-declare --single-unit arm7tdmis_types_pkg.sv arm7tdmis_bus_pkg.sv arm7tdmis_debug_pkg.sv arm7tdmis_ice_rt.sv arm7tdmis_debug_cover_formal.sv --top arm7tdmis_debug_cover_formal
