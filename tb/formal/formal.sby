regfile_prove: read_slang --std 1800-2017 --allow-use-before-declare --single-unit -D ARM7TDMIS_VERIFICATION arm7tdmis_types_pkg.sv arm7tdmis_instr_pkg.sv arm7tdmis_regfile.sv arm7tdmis_regfile_formal.sv --top arm7tdmis_regfile_formal
