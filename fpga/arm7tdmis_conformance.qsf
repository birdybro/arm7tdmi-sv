# Feature-complete raw-core characterization. This intentionally selects
# arm7tdmis_top so debug, JTAG, coprocessor, trace, endian, and raw bus ports
# remain observable and cannot be optimized away.

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY arm7tdmis_top

set_global_assignment -name QIP_FILE arm7tdmi_mister.qip
set_global_assignment -name SDC_FILE arm7tdmis_conformance.sdc

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY conformance_output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"

# CLK uses a representative Cyclone V global-clock pin so the fit includes a
# real clock tree. Every functional interface pin is virtual; this is a module
# characterization, not a programmable board pinout.
set_location_assignment PIN_V11 -to CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK
set_instance_assignment -name VIRTUAL_PIN ON -to CLKEN
set_instance_assignment -name VIRTUAL_PIN ON -to nRESET
set_instance_assignment -name VIRTUAL_PIN ON -to CFGBIGEND
set_instance_assignment -name VIRTUAL_PIN ON -to nIRQ
set_instance_assignment -name VIRTUAL_PIN ON -to nFIQ
set_instance_assignment -name VIRTUAL_PIN ON -to ABORT
set_instance_assignment -name VIRTUAL_PIN ON -to RDATA[0]
set_instance_assignment -name VIRTUAL_PIN ON -to RDATA[1]
set_instance_assignment -name VIRTUAL_PIN ON -to RDATA[2]
