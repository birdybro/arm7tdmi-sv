# Standalone elaboration example. A host MiSTer project normally imports only
# arm7tdmi_mister.qip and supplies its own top, pins, device, and timing policy.

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY arm7tdmi_mister_example_top

set_global_assignment -name QIP_FILE arm7tdmi_mister.qip
set_global_assignment -name SYSTEMVERILOG_FILE example/arm7tdmi_mister_example_top.sv
set_global_assignment -name SDC_FILE arm7tdmi_mister.sdc

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"

# This project characterizes the portable module, not a board pinout. CLK uses
# one representative global-clock pin so clock-tree delay is included; every
# interface signal is virtual to avoid accidental package assignments and the
# misleading "unassigned physical pins" warning. A real project replaces all
# of these assignments and supplies a clock matching its own SDC.
set_location_assignment PIN_V11 -to CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK
set_instance_assignment -name VIRTUAL_PIN ON -to RESET_N
set_instance_assignment -name VIRTUAL_PIN ON -to CPU_CE
set_instance_assignment -name VIRTUAL_PIN ON -to IRQ_ASYNC
set_instance_assignment -name VIRTUAL_PIN ON -to FIQ_ASYNC
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_VALID
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_READY
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_ADDR[0]
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_ADDR[1]
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_ADDR[2]
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_ADDR[3]
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_ADDR[4]
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_ADDR[5]
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_ADDR[6]
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_ADDR[7]
set_instance_assignment -name VIRTUAL_PIN ON -to MEM_ADDR[8]
